APP_NAME=ShirinFashionBD
APP_ENV=local
APP_KEY=base64:c2hpcmluZmFzaGlvbmJkX2luc3RhbGxlcl9rZXkzMiE=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
PUBLIC_STORAGE_URL="${APP_URL}/storage"
PUBLIC_STORAGE_ROOT=

JWT_SECRET=
JWT_TTL_MINUTES=1440
CUSTOMER_JWT_TTL_MINUTES=525600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use "public" for local storage, or "s3" for S3 + CDN media uploads.
FILESYSTEM_DISK=public
MEDIA_DISK="${FILESYSTEM_DISK}"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM_ADDRESS="your-email@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=https://cdn.shirinfashionbd.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_CALLBACK_BASE_URL="${APP_URL}"
